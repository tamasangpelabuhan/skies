rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Produk: Publik membaca etalase, HANYA admin terverifikasi yang bisa create/update/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 2. Kategori: Publik membaca kategori, HANYA admin terverifikasi yang bisa menambah/menghapus
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Pesanan: Pelanggan publik hanya bisa checkout (create), HANYA admin terverifikasi yang bisa membaca order dan update
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 4. Pengaturan Toko: Publik bisa membaca (nama toko, no WA, status), HANYA admin yang bisa mengubah
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
